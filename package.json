{
  "name": "inventario-bodega",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run api\" \"npm run frontend\"",
    "api": "npm run dev --prefix api",
    "frontend": "npm run dev --prefix frontend",
    "install:all": "npm install --prefix api && npm install --prefix frontend",
    "build": "npm run build --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
